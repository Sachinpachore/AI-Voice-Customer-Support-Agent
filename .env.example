# --- Required for the agent brain, STT, and TTS ---
OPENAI_API_KEY=sk-...

# Model used by the LangGraph agent (any OpenAI chat-completions model with tool calling)
AGENT_MODEL=gpt-4o-mini

# STT / TTS models
STT_MODEL=whisper-1
TTS_MODEL=tts-1
TTS_VOICE=alloy

# --- Only needed for real phone calls via Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Public HTTPS URL Twilio can reach (e.g. an ngrok tunnel), no trailing slash
PUBLIC_BASE_URL=https://your-tunnel.ngrok-free.app

# App
LOG_LEVEL=INFO
